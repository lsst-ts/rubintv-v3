# Copy to .env for local development. All vars are prefixed RUBINTV_, except
# the deployment site, which comes from RAPID_ANALYSIS_LOCATION.

RAPID_ANALYSIS_LOCATION=local

# Leave unset to use the models YAML packaged with the app
# (python/lsst/ts/rubintv/models/models_data.yaml). Only set this to point at
# a site-specific copy — a set-but-wrong path aborts startup.
# RUBINTV_MODELS_PATH=/path/to/models_data.yaml

# PVC cache directory for warm starts. Defaults to /scratch (the PVC mount
# used in deployments); when the directory is missing or unwritable the
# cache disables itself with a single warning, and history is re-scanned
# from S3 on every start. Set a writable (ideally persistent) path to get
# warm starts locally. Slices are written incrementally as history scans.
# RUBINTV_CACHE_DIR=./cache

# Optional: Redis for detector/admin live updates. Unset disables them.
# RUBINTV_REDIS_URL=redis://localhost:6379/0

RUBINTV_POLL_INTERVAL_SECONDS=1.0
RUBINTV_LOG_LEVEL=INFO
RUBINTV_JSON_LOGS=false
