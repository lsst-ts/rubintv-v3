# Copy to .env for local development. All vars are prefixed RUBINTV_.

RUBINTV_SITE=local
RUBINTV_MODELS_PATH=config/models_data.yaml

# PVC cache directory for warm starts. UNSET DISABLES THE DISK CACHE
# ENTIRELY: history is re-scanned from S3 on every start and never persists
# across restarts. Set this to a writable (ideally persistent) path to get
# warm starts. Slices are written incrementally as history is scanned.
# RUBINTV_CACHE_DIR=./cache

# Optional: Redis for detector/admin live updates. Unset disables them.
# RUBINTV_REDIS_URL=redis://localhost:6379/0

RUBINTV_POLL_INTERVAL_SECONDS=1.0
RUBINTV_LOG_LEVEL=INFO
RUBINTV_JSON_LOGS=false
